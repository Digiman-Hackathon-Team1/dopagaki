# apps/api/.env 로 복사해 값을 채운다. .env는 커밋하지 않는다.
ANTHROPIC_API_KEY=
# claude-haiku-5-5(기본) 또는 claude-sonnet-5-5
AGENT_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max
AGENT_EFFORT=medium
# 프롬프트 캐싱(도구 정의·시스템 프롬프트·대화 기록 앞부분). 1(기본)이면 켜고, 문제가 생기면 0으로 끈다.
AGENT_PROMPT_CACHE=1
# 배포된 web의 환율 파일. 비워 두면 스냅샷 환율을 쓴다(ADR 0010).
# 예: https://<web 주소>/naver-fx.json (로컬 web 개발 서버: http://localhost:5173/naver-fx.json)
WEB_FX_URL=
# 데모 응답 캐싱. 1이면 녹화한 대본(src/api/agent/data/demo-replies.json)과 같은 메시지에 녹화 응답을 돌려준다.
# 녹화: uv run python scripts/record_demo.py --id <대본 ID> --lang ja "메시지1" "메시지2"
AGENT_DEMO_CACHE=0
# 병원·가격 데이터를 어디서 읽을지. snapshot(기본)은 web 스냅샷 JSON, db는 DATABASE_URL의 DB.
# db로 쓰기 전에 `uv run python -m api.db.seed`로 마이그레이션과 데이터를 넣는다.
CATALOG_SOURCE=snapshot
# 비워 두면 apps/api/catalog.db(SQLite). Railway PostgreSQL은 postgres://... 주소를 그대로 넣어도 된다.
DATABASE_URL=
