{
  "openapi": "3.1.0",
  "info": {
    "title": "API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/agent/chat": {
      "post": {
        "tags": [
          "agent"
        ],
        "summary": "Post Agent Chat",
        "operationId": "postAgentChat",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "503": {
            "description": "API 키가 없어 에이전트를 사용할 수 없음"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Get Health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "title": "Userid",
            "description": "브라우저가 만든 익명 사용자 ID"
          },
          "threadId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Threadid",
            "description": "대화 ID. 없으면 새 대화를 시작한다"
          },
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message",
            "description": "이번 턴의 사용자 메시지. 앞뒤 공백을 지운 뒤 1~2000자"
          },
          "lang": {
            "type": "string",
            "enum": [
              "ja",
              "ko"
            ],
            "title": "Lang",
            "description": "응답 언어"
          }
        },
        "type": "object",
        "required": [
          "userId",
          "message",
          "lang"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "threadId": {
            "type": "string",
            "format": "uuid",
            "title": "Threadid"
          },
          "conditionSummary": {
            "type": "string",
            "title": "Conditionsummary"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "cards": {
            "items": {
              "$ref": "#/components/schemas/RecommendationCard"
            },
            "type": "array",
            "title": "Cards"
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/Question"
            },
            "type": "array",
            "title": "Questions"
          },
          "suggestions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Suggestions"
          },
          "cautions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Cautions"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "threadId",
          "conditionSummary",
          "answer",
          "cards",
          "questions",
          "suggestions",
          "cautions",
          "disclaimer"
        ],
        "title": "ChatResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "Question": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
          },
          "options": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Options"
          },
          "multiSelect": {
            "type": "boolean",
            "title": "Multiselect"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question",
          "options",
          "multiSelect"
        ],
        "title": "Question"
      },
      "RecommendationCard": {
        "properties": {
          "cardId": {
            "type": "string",
            "title": "Cardid",
            "description": "병원 ID와 시술 ID를 묶은 카드 ID"
          },
          "placeId": {
            "type": "string",
            "title": "Placeid"
          },
          "menuId": {
            "type": "string",
            "title": "Menuid"
          },
          "clinicNameJa": {
            "type": "string",
            "title": "Clinicnameja"
          },
          "clinicNameKo": {
            "type": "string",
            "title": "Clinicnameko"
          },
          "menuNameJa": {
            "type": "string",
            "title": "Menunameja"
          },
          "menuNameKo": {
            "type": "string",
            "title": "Menunameko"
          },
          "area": {
            "type": "string",
            "enum": [
              "sinchon",
              "hongdae",
              "myeongdong",
              "yongsan",
              "gangnam",
              "jamsil",
              "seongsu",
              "yeouido",
              "magok",
              "nowon",
              "cheonho",
              "gwanak"
            ],
            "title": "Area"
          },
          "stationJa": {
            "type": "string",
            "title": "Stationja"
          },
          "stationKo": {
            "type": "string",
            "title": "Stationko"
          },
          "japaneseSupport": {
            "type": "boolean",
            "title": "Japanesesupport"
          },
          "baseKrw": {
            "type": "integer",
            "title": "Basekrw",
            "description": "병원 표시 가격(원)"
          },
          "vatKrw": {
            "type": "integer",
            "title": "Vatkrw",
            "description": "더한 부가세(원). 표시 가격에 이미 포함돼 있으면 0"
          },
          "totalKrw": {
            "type": "integer",
            "title": "Totalkrw",
            "description": "부가세 포함 가격(원)"
          },
          "totalJpy": {
            "type": "integer",
            "title": "Totaljpy",
            "description": "부가세 포함 가격의 엔화 환산"
          },
          "krwPer100Jpy": {
            "type": "number",
            "title": "Krwper100Jpy",
            "description": "환산에 쓴 환율(100엔당 원)"
          },
          "fxDateLabel": {
            "type": "string",
            "title": "Fxdatelabel",
            "description": "환율 기준일. 예: 2026.11.25"
          },
          "jpAverageJpy": {
            "type": "integer",
            "title": "Jpaveragejpy",
            "description": "일본 주요 병원 세금 포함 공식가 평균"
          },
          "jpMinJpy": {
            "type": "integer",
            "title": "Jpminjpy"
          },
          "jpMaxJpy": {
            "type": "integer",
            "title": "Jpmaxjpy"
          },
          "jpClinicCount": {
            "type": "integer",
            "title": "Jpcliniccount",
            "description": "일본 평균에 쓴 병원 수"
          },
          "savingsJpy": {
            "type": "integer",
            "title": "Savingsjpy",
            "description": "일본 평균 대비 절약액(엔). 음수면 더 비쌈"
          },
          "savingsPct": {
            "type": "integer",
            "title": "Savingspct"
          },
          "distanceMeters": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Distancemeters",
            "description": "기준 위치에서의 직선거리. 기준 위치가 없으면 null"
          },
          "walkMinutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Walkminutes"
          },
          "priceConditionJa": {
            "type": "string",
            "title": "Priceconditionja",
            "description": "가격 조건(첫 방문 한정, 이벤트가 등)"
          },
          "priceConditionKo": {
            "type": "string",
            "title": "Priceconditionko"
          },
          "priceNoteJa": {
            "type": "string",
            "title": "Pricenoteja",
            "description": "가격 출처 메모"
          },
          "priceNoteKo": {
            "type": "string",
            "title": "Pricenoteko"
          },
          "sourceUrl": {
            "type": "string",
            "title": "Sourceurl",
            "description": "병원 공식 가격 출처"
          },
          "kind": {
            "type": "string",
            "const": "recommendation",
            "title": "Kind"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason",
            "description": "LLM이 쓴 추천 이유 한 줄. LLM이 빠뜨리면 null"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "cardId",
          "placeId",
          "menuId",
          "clinicNameJa",
          "clinicNameKo",
          "menuNameJa",
          "menuNameKo",
          "area",
          "stationJa",
          "stationKo",
          "japaneseSupport",
          "baseKrw",
          "vatKrw",
          "totalKrw",
          "totalJpy",
          "krwPer100Jpy",
          "fxDateLabel",
          "jpAverageJpy",
          "jpMinJpy",
          "jpMaxJpy",
          "jpClinicCount",
          "savingsJpy",
          "savingsPct",
          "distanceMeters",
          "walkMinutes",
          "priceConditionJa",
          "priceConditionKo",
          "priceNoteJa",
          "priceNoteKo",
          "sourceUrl",
          "kind",
          "reason"
        ],
        "title": "RecommendationCard"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
