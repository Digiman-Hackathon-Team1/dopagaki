{
  "openapi": "3.1.0",
  "info": {
    "title": "API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/agent/chat": {
      "post": {
        "tags": [
          "agent"
        ],
        "summary": "Post Agent Chat",
        "operationId": "postAgentChat",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "503": {
            "description": "API 키가 없어 에이전트를 사용할 수 없음"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Get Health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "title": "Userid",
            "description": "브라우저가 만든 익명 사용자 ID"
          },
          "threadId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Threadid",
            "description": "대화 ID. 없으면 새 대화를 시작한다"
          },
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message",
            "description": "이번 턴의 사용자 메시지. 앞뒤 공백을 지운 뒤 1~2000자"
          },
          "lang": {
            "type": "string",
            "enum": [
              "ja",
              "ko"
            ],
            "title": "Lang",
            "description": "응답 언어"
          }
        },
        "type": "object",
        "required": [
          "userId",
          "message",
          "lang"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "threadId": {
            "type": "string",
            "format": "uuid",
            "title": "Threadid"
          },
          "conditionSummary": {
            "type": "string",
            "title": "Conditionsummary"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "cards": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/RecommendationCard"
                },
                {
                  "$ref": "#/components/schemas/LocationCard"
                },
                {
                  "$ref": "#/components/schemas/JpMatchCard"
                }
              ],
              "discriminator": {
                "propertyName": "kind",
                "mapping": {
                  "jp_match": "#/components/schemas/JpMatchCard",
                  "location": "#/components/schemas/LocationCard",
                  "recommendation": "#/components/schemas/RecommendationCard"
                }
              }
            },
            "type": "array",
            "title": "Cards",
            "description": "kind로 종류를 구분한다. jp_match(일본 시술명 대응), location(이번 턴에 찾은 기준 위치), recommendation(병원 추천) 순서로 온다"
          },
          "exclusions": {
            "items": {
              "$ref": "#/components/schemas/Exclusion"
            },
            "type": "array",
            "title": "Exclusions",
            "description": "이번 턴 검색에서 거르기로 빠진 병원 수. 없으면 빈 배열"
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/Question"
            },
            "type": "array",
            "title": "Questions"
          },
          "suggestions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Suggestions"
          },
          "cautions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Cautions"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "threadId",
          "conditionSummary",
          "answer",
          "cards",
          "exclusions",
          "questions",
          "suggestions",
          "cautions",
          "disclaimer"
        ],
        "title": "ChatResponse"
      },
      "Exclusion": {
        "properties": {
          "menuId": {
            "type": "string",
            "title": "Menuid"
          },
          "reason": {
            "type": "string",
            "enum": [
              "needle",
              "downtime",
              "area",
              "japanese",
              "budget"
            ],
            "title": "Reason",
            "description": "needle 바늘 시술 기피, downtime 회복 기간 초과(이 둘은 시술 전체가 빠짐), area 다른 지역, japanese 일본어 미지원, budget 예산 초과"
          },
          "clinicCount": {
            "type": "integer",
            "title": "Cliniccount",
            "description": "이 사유로 빠진 병원 수"
          },
          "searchId": {
            "type": "string",
            "title": "Searchid",
            "description": "어느 검색의 제외 사유인지. 같은 턴의 카드 searchId와 같다"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "menuId",
          "reason",
          "clinicCount",
          "searchId"
        ],
        "title": "Exclusion"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "JpClinicPrice": {
        "properties": {
          "nameJa": {
            "type": "string",
            "title": "Nameja"
          },
          "nameKo": {
            "type": "string",
            "title": "Nameko"
          },
          "planJa": {
            "type": "string",
            "title": "Planja",
            "description": "일본 병원의 플랜명. 단위(샷 수, cc, 단위 수)가 들어 있고 한국 메뉴와 단위가 다를 수 있다. 예: ウルトラスキンハイフ 全顔 (650ショット)"
          },
          "planKo": {
            "type": "string",
            "title": "Planko"
          },
          "priceJpy": {
            "type": "integer",
            "title": "Pricejpy",
            "description": "세금 포함 공식가(엔)"
          },
          "sourceUrl": {
            "type": "string",
            "title": "Sourceurl",
            "description": "일본 병원 공식 가격 출처"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "nameJa",
          "nameKo",
          "planJa",
          "planKo",
          "priceJpy",
          "sourceUrl"
        ],
        "title": "JpClinicPrice",
        "description": "사용자가 다니던 일본 병원의 가격. 데이터의 일본 벤치마크 병원 한 곳이다(설계 문서 4.7)."
      },
      "JpClinicSavings": {
        "properties": {
          "nameJa": {
            "type": "string",
            "title": "Nameja"
          },
          "nameKo": {
            "type": "string",
            "title": "Nameko"
          },
          "planJa": {
            "type": "string",
            "title": "Planja",
            "description": "일본 병원의 플랜명. 단위(샷 수, cc, 단위 수)가 들어 있고 한국 메뉴와 단위가 다를 수 있다. 예: ウルトラスキンハイフ 全顔 (650ショット)"
          },
          "planKo": {
            "type": "string",
            "title": "Planko"
          },
          "priceJpy": {
            "type": "integer",
            "title": "Pricejpy",
            "description": "세금 포함 공식가(엔)"
          },
          "sourceUrl": {
            "type": "string",
            "title": "Sourceurl",
            "description": "일본 병원 공식 가격 출처"
          },
          "savingsJpy": {
            "type": "integer",
            "title": "Savingsjpy",
            "description": "이 일본 병원 가격 대비 절약액(엔). 음수면 한국이 더 비쌈"
          },
          "savingsPct": {
            "type": "integer",
            "title": "Savingspct"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "nameJa",
          "nameKo",
          "planJa",
          "planKo",
          "priceJpy",
          "sourceUrl",
          "savingsJpy",
          "savingsPct"
        ],
        "title": "JpClinicSavings"
      },
      "JpMatchCard": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query",
            "description": "사용자가 말한 일본 시술명. 예: ハイフ"
          },
          "menuId": {
            "type": "string",
            "title": "Menuid",
            "description": "대응하는 한국 시술 ID"
          },
          "menuNameJa": {
            "type": "string",
            "title": "Menunameja"
          },
          "menuNameKo": {
            "type": "string",
            "title": "Menunameko"
          },
          "reasonJa": {
            "type": "string",
            "title": "Reasonja",
            "description": "한국과 일본에서 이름이 다른 이유 한 줄"
          },
          "reasonKo": {
            "type": "string",
            "title": "Reasonko"
          },
          "unitNoteJa": {
            "type": "string",
            "title": "Unitnoteja",
            "description": "한국·일본의 단위 차이. 예: 300샷과 650샷"
          },
          "unitNoteKo": {
            "type": "string",
            "title": "Unitnoteko"
          },
          "jpClinic": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JpClinicPrice"
              },
              {
                "type": "null"
              }
            ],
            "description": "사용자가 말한 일본 병원의 이 시술 가격. 말하지 않았거나 데이터에 없으면 null"
          },
          "kind": {
            "type": "string",
            "const": "jp_match",
            "title": "Kind"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query",
          "menuId",
          "menuNameJa",
          "menuNameKo",
          "reasonJa",
          "reasonKo",
          "unitNoteJa",
          "unitNoteKo",
          "jpClinic",
          "kind"
        ],
        "title": "JpMatchCard"
      },
      "LocationCard": {
        "properties": {
          "locationId": {
            "type": "string",
            "title": "Locationid",
            "description": "위치 ID. 예: area:hongdae(지역), station:홍대입구(역)"
          },
          "locationType": {
            "type": "string",
            "enum": [
              "area",
              "station"
            ],
            "title": "Locationtype",
            "description": "area 지역 중심 좌표, station 역 좌표"
          },
          "query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Query",
            "description": "위치를 찾은 사용자 표현. 예: 홍대 숙소. resolve_location을 거치지 않은 위치 ID로 검색했으면 null"
          },
          "nameJa": {
            "type": "string",
            "title": "Nameja"
          },
          "nameKo": {
            "type": "string",
            "title": "Nameko"
          },
          "lat": {
            "type": "number",
            "title": "Lat"
          },
          "lng": {
            "type": "number",
            "title": "Lng"
          },
          "kind": {
            "type": "string",
            "const": "location",
            "title": "Kind"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "locationId",
          "locationType",
          "query",
          "nameJa",
          "nameKo",
          "lat",
          "lng",
          "kind"
        ],
        "title": "LocationCard"
      },
      "Question": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
          },
          "options": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Options"
          },
          "multiSelect": {
            "type": "boolean",
            "title": "Multiselect"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question",
          "options",
          "multiSelect"
        ],
        "title": "Question"
      },
      "RecommendationCard": {
        "properties": {
          "cardId": {
            "type": "string",
            "title": "Cardid",
            "description": "병원 ID와 시술 ID를 묶은 카드 ID"
          },
          "placeId": {
            "type": "string",
            "title": "Placeid"
          },
          "menuId": {
            "type": "string",
            "title": "Menuid"
          },
          "clinicNameJa": {
            "type": "string",
            "title": "Clinicnameja"
          },
          "clinicNameKo": {
            "type": "string",
            "title": "Clinicnameko"
          },
          "menuNameJa": {
            "type": "string",
            "title": "Menunameja"
          },
          "menuNameKo": {
            "type": "string",
            "title": "Menunameko"
          },
          "area": {
            "type": "string",
            "enum": [
              "sinchon",
              "hongdae",
              "myeongdong",
              "yongsan",
              "gangnam",
              "jamsil",
              "seongsu",
              "yeouido",
              "magok",
              "nowon",
              "cheonho",
              "gwanak"
            ],
            "title": "Area"
          },
          "stationJa": {
            "type": "string",
            "title": "Stationja"
          },
          "stationKo": {
            "type": "string",
            "title": "Stationko"
          },
          "japaneseSupport": {
            "type": "boolean",
            "title": "Japanesesupport"
          },
          "baseKrw": {
            "type": "integer",
            "title": "Basekrw",
            "description": "병원 표시 가격(원)"
          },
          "vatKrw": {
            "type": "integer",
            "title": "Vatkrw",
            "description": "더한 부가세(원). 표시 가격에 이미 포함돼 있으면 0"
          },
          "totalKrw": {
            "type": "integer",
            "title": "Totalkrw",
            "description": "부가세 포함 가격(원)"
          },
          "totalJpy": {
            "type": "integer",
            "title": "Totaljpy",
            "description": "부가세 포함 가격의 엔화 환산"
          },
          "krwPer100Jpy": {
            "type": "number",
            "title": "Krwper100Jpy",
            "description": "환산에 쓴 환율(100엔당 원)"
          },
          "fxDateLabel": {
            "type": "string",
            "title": "Fxdatelabel",
            "description": "환율 기준일. 예: 2026.11.25"
          },
          "jpAverageJpy": {
            "type": "integer",
            "title": "Jpaveragejpy",
            "description": "일본 주요 병원 세금 포함 공식가 평균"
          },
          "jpMinJpy": {
            "type": "integer",
            "title": "Jpminjpy"
          },
          "jpMaxJpy": {
            "type": "integer",
            "title": "Jpmaxjpy"
          },
          "jpClinicCount": {
            "type": "integer",
            "title": "Jpcliniccount",
            "description": "일본 평균에 쓴 병원 수"
          },
          "savingsJpy": {
            "type": "integer",
            "title": "Savingsjpy",
            "description": "일본 평균 대비 절약액(엔). 음수면 더 비쌈"
          },
          "savingsPct": {
            "type": "integer",
            "title": "Savingspct"
          },
          "jpClinic": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JpClinicSavings"
              },
              {
                "type": "null"
              }
            ],
            "description": "사용자가 다니던 일본 병원과 직접 비교한 가격과 절약액. 그 병원의 이 시술 가격이 데이터에 있을 때만 채우고, 없으면 null(일본 평균 대비만 표시)"
          },
          "distanceMeters": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Distancemeters",
            "description": "기준 위치에서의 직선거리. 기준 위치가 없으면 null"
          },
          "walkMinutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Walkminutes"
          },
          "priceTags": {
            "items": {
              "type": "string",
              "enum": [
                "first_visit",
                "event",
                "day_limited",
                "app_benefit",
                "anesthesia",
                "extra_fee"
              ]
            },
            "type": "array",
            "title": "Pricetags",
            "description": "가격 조건 태그(설계 4.7). first_visit 첫 방문·체험가, event 이벤트가·특가, day_limited 요일 한정, app_benefit 앱·카카오 혜택가, anesthesia 마취비 별도·확인, extra_fee 시술 팁 별도. 절약액 계산에는 반영하지 않는다"
          },
          "priceConditionJa": {
            "type": "string",
            "title": "Priceconditionja",
            "description": "가격 조건(첫 방문 한정, 이벤트가 등)"
          },
          "priceConditionKo": {
            "type": "string",
            "title": "Priceconditionko"
          },
          "priceNoteJa": {
            "type": "string",
            "title": "Pricenoteja",
            "description": "가격 출처 메모"
          },
          "priceNoteKo": {
            "type": "string",
            "title": "Pricenoteko"
          },
          "sourceUrl": {
            "type": "string",
            "title": "Sourceurl",
            "description": "병원 공식 가격 출처"
          },
          "kind": {
            "type": "string",
            "const": "recommendation",
            "title": "Kind"
          },
          "searchId": {
            "type": "string",
            "title": "Searchid",
            "description": "어느 검색의 카드인지(이번 턴 검색 순서, 예: s1). 지점·지역을 비교하면 검색마다 값이 다르므로 화면이 묶어 보여 줄 수 있다. 같은 병원이 두 검색에 모두 나오면 카드도 두 장이다"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason",
            "description": "LLM이 쓴 추천 이유 한 줄. LLM이 빠뜨리면 null"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "cardId",
          "placeId",
          "menuId",
          "clinicNameJa",
          "clinicNameKo",
          "menuNameJa",
          "menuNameKo",
          "area",
          "stationJa",
          "stationKo",
          "japaneseSupport",
          "baseKrw",
          "vatKrw",
          "totalKrw",
          "totalJpy",
          "krwPer100Jpy",
          "fxDateLabel",
          "jpAverageJpy",
          "jpMinJpy",
          "jpMaxJpy",
          "jpClinicCount",
          "savingsJpy",
          "savingsPct",
          "jpClinic",
          "distanceMeters",
          "walkMinutes",
          "priceTags",
          "priceConditionJa",
          "priceConditionKo",
          "priceNoteJa",
          "priceNoteKo",
          "sourceUrl",
          "kind",
          "searchId",
          "reason"
        ],
        "title": "RecommendationCard"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
