{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {},
    "@repo/web#build": {
      "cache": false,
      "dependsOn": [
        "^build",
        "typecheck",
        "test"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@repo/web#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "public/official-proofs/**",
        "public/official-proofs-ja/**"
      ]
    }
  }
}
